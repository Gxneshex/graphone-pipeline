# ==============================================================================
# Graphone-Pipeline Environment Configuration Template
# Duplicate this file to '.env' and populate your local credentials before running.
# ==============================================================================

# --- LLM API Provider Credentials ---
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Pipeline Orchestrator Settings ---
PRIMARY_LLM_MODEL=gpt-4o-mini
FALLBACK_LLM_MODEL=gpt-4o

# --- Scraper Parameters ---
MAX_PAPERS_TO_SCRAPE=5
SCRAPER_REQUEST_TIMEOUT_SECONDS=15

# --- System Execution Environment ---
# Options: development, staging, production
ENVIRONMENT=development
